#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
// | TILDE | 1    | 2    | 3    | 4    | 5    |                   | 6    | 7    | 8    | 9    | 0    | MINUS |
// | LBKT  | Q    | W    | E    | R    | T    |                   | Y    | U    | I    | O    | P    | RBKT  |
// | TAB   | A    | S    | D    | F    | G    |                   | H    | J    | K    | L    | SEMI | SQT   |
// | LSHFT | Z    | X    | C    | V    | B    | BSPC |     | RET  | N    | M    | ,    | .    | ?    | RSHFT |
// | LCTRL | LGUI | MO2  | LALT | BSPC | SPACE|                   | DEL  | PLUS | MO1  | ESC  | RCTL | RALT  |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                   RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                   RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                   RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)   RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)                   RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};

/* Free up matrix GPIOs that nice!nano v2's default pinctrl assigns to peripherals.
 * Right half cols 4/5 collide with i2c0/spi1; disabling those peripherals lets
 * kscan own the pins. uart0 stays disabled too — although the bootloader leaves
 * UARTE0.PSEL.TXD/RXD bound to P0.06/P0.08 so right-half col 2 (the U/J/M
 * column + inner thumbs) is not freed by status="disabled" alone. That's a
 * known limitation of this baseline. */
&uart0 { status = "disabled"; };
&i2c0  { status = "disabled"; };
&spi1  { status = "disabled"; };

/* Release P0.09 (NFC1) and P0.10 (NFC2) from the nRF52840's NFC peripheral so
 * they work as standard GPIOs in the matrix. Programs UICR on first boot.
 * Reverting requires `nrfjprog --eraseall` per MCU. */
&uicr {
    nfct-pins-as-gpios;
};
